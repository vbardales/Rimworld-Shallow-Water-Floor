<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Shallow water, laid down like a floor.

       terrainAffordanceNeeded takes ONE value, not a list: the game reads it as a
       single TerrainAffordanceDef. The original listed Heavy and Light, which the
       parser ran together into "HeavyLight" - a surface no def declares - so
       neither terrain could ever be built. Light is the permissive one of the two,
       and every soil and floor provides it. -->
  <TerrainDef ParentName="WaterShallowBase">
    <defName>RuneWaterShallow</defName>
    <label>shallow water</label>
    <description>A shallow pool, dug out and flooded a tile at a time. It behaves like the natural kind: pawns wade through it, it can be bridged over, and nothing grows in it.</description>
    <texturePath>Terrain/Surfaces/WaterShallowRamp</texturePath>
    <waterDepthShader>Map/WaterDepth</waterDepthShader>
    <renderPrecedence>394</renderPrecedence>
    <costList>
      <WoodLog>2</WoodLog>
    </costList>
    <!-- WaterShallowBase declares no WorkToBuild, and the stat's defaultBaseValue is 1:
         without this the tile was laid instantly. 120 puts it alongside straw matting,
         a shade above the 85 of a wood floor - digging out a tile and flooding it is
         not less work than laying planks over it. -->
    <statBases>
      <WorkToBuild>120</WorkToBuild>
    </statBases>
    <designationCategory>Floors</designationCategory>
    <drawStyleCategory>Floors</drawStyleCategory>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <layerable>true</layerable>
  </TerrainDef>

  <!-- The same water, but crops grow in it.

       affordances is overridden rather than extended, so this one does NOT inherit
       the water affordances of its parent - no ShallowWater, no Bridgeable. That is
       the author's choice and it is kept: it is what makes the tile behave like
       ground you can plant on rather than like water. -->
  <TerrainDef ParentName="WaterShallowBase">
    <defName>RuneFertileWater</defName>
    <label>fertile water</label>
    <description>Shallow water seeded with silt and rotting matter, rich enough to grow crops in and shallow enough to walk through without slowing down. It is not water any more as far as the colony is concerned: nothing can be bridged over it, and it will not carry a waterproof conduit.</description>
    <texturePath>Terrain/Surfaces/WaterShallowRamp</texturePath>
    <waterDepthShader>Map/WaterDepth</waterDepthShader>
    <renderPrecedence>394</renderPrecedence>
    <costList>
      <WoodLog>2</WoodLog>
    </costList>
    <!-- Same missing-stat fix as above, but priced higher: this tile beats plain soil
         on fertility for two wood and no power. A hydroponics basin costs 2800 work
         for four tiles - 700 each - on top of steel, components and a power hookup,
         for fertility 2.8. 400 sits well under that per tile while no longer being free. -->
    <statBases>
      <WorkToBuild>400</WorkToBuild>
    </statBases>
    <designationCategory>Floors</designationCategory>
    <drawStyleCategory>Floors</drawStyleCategory>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <layerable>true</layerable>
    <pathCost>0</pathCost>
    <resourcesFractionWhenDeconstructed>0.4</resourcesFractionWhenDeconstructed>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <fertility>1.25</fertility>
  </TerrainDef>

</Defs>
